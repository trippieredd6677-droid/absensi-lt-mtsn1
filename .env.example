# =======================
# Absensi LT MTsN 1 Kebumen — .env.example
# Copy ke .env lalu isi nilai asli.
# =======================

# Server
PORT=5001
NODE_ENV=production
# Origin frontend (di produksi Wajib diisi; CORS hanya allow origin ini)
CLIENT_URL=https://absensi.mtsn1kebumen.id

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=absensi_lt
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=2h

# ===== Admin awal (dibuat `node setup-db.js` hanya kalau diset) =====
# Isi di produksi biar ada akun admin pertama. Kalau kosong, admin default TIDAK dibuat.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=          # <- isi password admin kuat (min 8, campur huruf+angka+simbol)

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ===== SMTP Email (untuk kirim kode OTP reset password) =====
# Pakai App Password saat Gmail aktifkan 2FA:
#   Google Account > Security > 2-Step Verification > App passwords
# Email OTP TIDAK terkirim asli kalau EMAIL_USER/EMAIL_PASS kosong.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=            # <- isi alamat Gmail pengirim (contoh: absensi@mtsn1kebumen.id)
EMAIL_PASS=            # <- isi App Password Gmail (16 karakter)
EMAIL_FROM=Absensi LT MTsN 1 Kebumen
# MAIL_LOGGING=true = mode dev: OTP muncul di layar + ke console (TIDAK dikirim asli).
# Set FALSE setelah EMAIL_USER/EMAIL_PASS terisi biar email beneran keluar.
MAIL_LOGGING=true
